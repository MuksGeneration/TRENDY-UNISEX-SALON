{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|manifest\\.webmanifest$|sw\\.js$|workbox-|pwa-|apple-touch-icon\\.png$|icon\\.svg$).*)",
      "destination": "/index.html"
    }
  ]
}
