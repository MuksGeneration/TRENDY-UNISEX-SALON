# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Environment Variables or AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# SESSION_SECRET: Strong random secret used to sign staff session tokens across Vercel instances.
SESSION_SECRET="CHANGE_TO_A_LONG_RANDOM_SECRET"

# ==================== VERCEL CLOUD DATABASE (GOOGLE SHEETS) & STORAGE (GOOGLE DRIVE) ====================
# Option 1 (Recommended — NO Google Service Account Needed!):
# Open your Google Sheet -> Extensions -> Apps Script, paste Code.gs from Settings -> Google Workspace,
# Deploy as Web App (Execute as: Me, Who has access: Anyone), and paste the Web App URL here:
GOOGLE_APPS_SCRIPT_URL=""
# Optional shared secret matching Script Property SALON_BRIDGE_SECRET in Apps Script:
GOOGLE_APPS_SCRIPT_SECRET=""

# Optional explicit Spreadsheet / Drive Folder IDs (also auto-detected by Apps Script bridge):
GOOGLE_SPREADSHEET_ID=""
GOOGLE_DRIVE_FOLDER_ID=""

# Option 2 (Alternative): OAuth 2.0 Refresh Token credentials (if using direct Sheets/Drive REST APIs)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""

